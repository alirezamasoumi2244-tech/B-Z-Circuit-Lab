{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "B-Z Circuit Lab",
  "version": "0.2.0",
  "identifier": "com.bzteam.circuitlab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "B-Z Circuit Lab",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool"
  }
}